{
  "name": "staatslenker",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Regierungssimulator „Staatslenker“ — deterministische Kern-Engine plus CLI- und Web-Adapter",
  "workspaces": [
    "core",
    "content/base",
    "loader",
    "cli"
  ],
  "scripts": {
    "build": "tsc -b tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json",
    "check:core-isolation": "node scripts/check-core-isolation.mjs",
    "test": "npm run build && vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "dev": "npm run dev --workspace cli"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@types/node": "^22.0.0",
    "eslint": "^9.0.0",
    "prettier": "^3.3.0",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.0.0",
    "vitest": "^5.0.0"
  }
}
